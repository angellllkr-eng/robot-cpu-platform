{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindreply.example/schemas/prompt-contract.schema.json",
  "title": "MindReply Production Prompt Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "identity",
    "objective",
    "scope",
    "instruction_hierarchy",
    "input_contract",
    "tools",
    "output_contract",
    "failure_handling",
    "security_boundaries",
    "evaluation_criteria"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "identity": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "instruction_hierarchy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "input_contract": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "schema_ref": {
          "type": "string",
          "format": "uri-reference"
        },
        "untrusted_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "purpose",
          "permission"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "permission": {
            "type": "string",
            "enum": [
              "read",
              "write_approved",
              "owner_only",
              "unavailable"
            ]
          }
        }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "description"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "text",
            "json",
            "json_schema",
            "markdown"
          ]
        },
        "description": {
          "type": "string"
        },
        "schema_ref": {
          "type": "string",
          "format": "uri-reference"
        }
      }
    },
    "failure_handling": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "security_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evaluation_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "model_policy_ref": {
      "type": "string",
      "format": "uri-reference"
    },
    "owner": {
      "type": "string"
    }
  }
}
